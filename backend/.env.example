# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string for local Docker/Postgres development
DATABASE_URL=postgresql://janseva:janseva@localhost:5432/janseva

# Secret used to sign JWT tokens — use a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the Express server runs on
PORT=5000

# Set true only for a local/demo environment if you need self-registration of officers
ALLOW_OFFICER_REGISTRATION=false

# AI service URL (Python FastAPI app under /ai-service)
AI_SERVICE_URL=http://localhost:8000

# AI provider configuration for the Python AI service.
# Supported values: openai_compatible, mock
AI_PROVIDER=openai_compatible
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_with_provider_api_key
AI_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=3

# Private key used by the AI microservice for service-to-service writes
AI_SERVICE_API_KEY=replace_with_a_long_random_service_key
