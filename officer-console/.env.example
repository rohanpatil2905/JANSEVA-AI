# ============================================================================
# JanSeva AI — Officer Console Environment Configuration Template
# ============================================================================
# Copy this file to `.env` or `.env.local` to configure backend integration.
# DO NOT store real API keys, secrets, or passwords in this file.

# Backend API Gateway Base URL
# Example for local development backend: http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Data Adapter Strategy Mode:
# 'mock' -> Uses authoritative prototype municipal dataset & sessionStorage (Default)
# 'api'  -> Connects to backend REST API via centralized apiClient
VITE_DATA_SOURCE=api
